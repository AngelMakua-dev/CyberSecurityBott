<Window x:Class="CyberSecurityBott.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="1000"
        Background="#0D1117">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Background="#161B22"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="🔐 CYBERSECURITY AWARENESS BOT"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="Cyan"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Your Guide To Staying Safe Online"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>
        </Border>

        <!-- CHAT AREA -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <TextBox x:Name="ChatDisplay"
                     Background="#161B22"
                     Foreground="White"
                     FontSize="16"
                     BorderThickness="0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>

        </ScrollViewer>

        <!-- INPUT AREA -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <TextBox x:Name="UserInput"
                     Width="700"
                     Height="40"
                     FontSize="16"
                     Background="#21262D"
                     Foreground="White"
                     BorderBrush="Cyan"/>

            <Button x:Name="SendButton"
                    Content="Send"
                    Width="120"
                    Height="40"
                    Margin="10,0"
                    Background="Cyan"
                    Foreground="Black"
                    FontWeight="Bold"
                    Click="SendButton_Click"/>

            <Button x:Name="ClearButton"
                    Content="Clear"
                    Width="120"
                    Height="40"
                    Background="#30363D"
                    Foreground="White"
                    Click="ClearButton_Click"/>

        </StackPanel>

    </Grid>
</Window>